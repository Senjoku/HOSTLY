# ==============================================================================
# HOSTLY — CONFIGURATION DE SÉCURITÉ ET PERFORMANCE DU SERVEUR (APACHE / LITESPEED)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PARAMÈTRES GLOBAUX & DÉSACTIVATION DES SIGNATURES
# ------------------------------------------------------------------------------
ServerSignature Off
Options -Indexes -MultiViews

# Forcer le charset UTF-8
AddDefaultCharset UTF-8
DefaultLanguage fr

# ------------------------------------------------------------------------------
# 2. BLOCAGE DES FICHIERS CACHÉS & SENSIBLES
# ------------------------------------------------------------------------------
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|git|md|yml|yaml)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protéger le fichier .htaccess lui-même
<Files .htaccess>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# ------------------------------------------------------------------------------
# 3. RÉÉCRITURE D'URL & REDIRECTION HTTPS STRICTE
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bloquer les requêtes suspectes ou méthodes dangereuses (TRACE, TRACK)
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
    RewriteRule .* - [F]

    # Redirection automatique vers HTTPS si non sécurisé
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# 4. EN-TÊTES DE SÉCURITÉ HTTP (SECURITY HEADERS)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # HSTS (Strict-Transport-Security) : Forcer HTTPS pendant 1 an (y compris sous-domaines)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Anti-Clickjacking : Empêche l'intégration dans une iframe externe malveillante
    Header always set X-Frame-Options "SAMEORIGIN"

    # Anti-Sniffing : Empêche le navigateur d'interpréter un fichier sous un autre type MIME
    Header always set X-Content-Type-Options "nosniff"

    # Politique de Referrer sécurisée
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions-Policy : Désactive l'accès aux capteurs sensibles non requis
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Cross-Origin Policies
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Content-Security-Policy (CSP)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self';"

    # Supprimer l'en-tête de version du serveur (X-Powered-By)
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------------------
# 5. PAGE D'ERREUR 404 PERSONNALISÉE
# ------------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# 6. COMPRESSION GZIP / BROTLI (PERFORMANCE & PROTECTION RESSOURCES)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 7. GESTION DU CACHE NAVIGATEUR (CACHE-CONTROL & EXPIRES)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # CSS, JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images & SVG
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # Polices web
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # HTML (Court pour fraîcheur des mises à jour)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
